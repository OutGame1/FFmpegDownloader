<ui:FluentWindow x:Class="FFmpegDownloader.Windows.AdvancedOptionsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:FFmpegDownloader.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:AdvancedOptionsViewModel}"
                 Title="Options avancées"
                 Width="700"
                 Height="560"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre de titre -->
        <ui:TitleBar Title="Options avancées"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <!-- Contenu -->
        <Grid Grid.Row="1"
              Margin="24,16">

            <TabControl>

                <!-- HTTP -->
                <TabItem Header="HTTP">
                    <Grid Margin="8,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="En-têtes HTTP"
                                       FontSize="20"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Personnalisez les en-têtes envoyés lors de la requête HTTP."
                                       Foreground="#A0A0A0"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- En-têtes -->
                            <Grid Grid.Row="0"
                                  Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Nom"
                                           FontWeight="SemiBold" />

                                <TextBlock Grid.Column="1"
                                           Text="Valeur"
                                           FontWeight="SemiBold" />

                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">

                                <ItemsControl ItemsSource="{Binding Headers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="40" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="36"
                                                         Margin="0,0,8,0" />

                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="36"
                                                         Margin="0,0,8,0" />

                                                <Button Grid.Column="2"
                                                        Content="✕"
                                                        Height="36"
                                                        Command="{Binding DataContext.RemoveHeaderCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Supprimer cet en-tête" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </ScrollViewer>

                            <Button Grid.Row="2"
                                    Content="Ajouter un en-tête"
                                    Command="{Binding AddHeaderCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    Height="36"
                                    Padding="16,0" />
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Métadonnées -->
                <TabItem Header="Métadonnées">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,16">

                            <TextBlock Text="Métadonnées vidéo"
                                       FontSize="20"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Informations intégrées au fichier vidéo de sortie."
                                       Foreground="#A0A0A0"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,20" />

                            <TextBlock Text="Titre"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"
                                     Margin="0,4,0,16" />

                            <TextBlock Text="Artiste"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"
                                     Margin="0,4,0,16" />

                            <TextBlock Text="Album"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"
                                     Margin="0,4,0,16" />

                            <TextBlock Text="Date"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"
                                     Margin="0,4,0,16" />

                            <TextBlock Text="Genre"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"
                                     Margin="0,4,0,16" />

                            <TextBlock Text="Commentaire"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                     Height="80"
                                     Margin="0,4,0,16"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- FFmpeg -->
                <TabItem Header="FFmpeg">
                    <Grid Margin="8,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Arguments supplémentaires"
                                       FontSize="20"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Ajoutez des arguments FFmpeg personnalisés à la commande générée."
                                       Foreground="#A0A0A0"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBox Grid.Row="1"
                                 Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono"
                                 FontSize="13"
                                 Padding="12" />
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- Boutons -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="#404040"
                Padding="24,16">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Annuler"
                        Height="36"
                        Padding="20,0"
                        Margin="0,0,8,0" />

                <Button Content="Valider"
                        Height="36"
                        Padding="20,0" />

            </StackPanel>
        </Border>

    </Grid>
</ui:FluentWindow>
