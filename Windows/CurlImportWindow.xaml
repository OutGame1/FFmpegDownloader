<ui:FluentWindow x:Class="FFmpegDownloader.Windows.CurlImportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:FFmpegDownloader.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:CurlImportViewModel}"
                 Title="Importer une commande cURL"
                 Width="680"
                 Height="440"
                 MinWidth="500"
                 MinHeight="350"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Importer une commande cURL"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <Grid Grid.Row="1"
              Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Collez votre commande cURL (format Bash) ci-dessous."
                       Margin="0,0,0,12"
                       TextWrapping="Wrap" />

            <TextBox x:Name="CommandTextBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono"
                     FontSize="13"
                     Padding="12" />
        </Grid>

        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="#404040"
                Padding="24,16">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Annuler"
                        Height="36"
                        Padding="20,0"
                        Margin="0,0,8,0"
                        Click="Cancel_Click" />

                <Button Content="Importer"
                        Height="36"
                        Padding="20,0"
                        IsDefault="True"
                        Click="Import_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
