<ui:FluentWindow x:Class="FFmpegDownloader.Windows.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:FFmpegDownloader.ViewModels"
                 xmlns:enums="clr-namespace:FFmpegDownloader.Enums"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="FFmpeg Downloader"
                 ResizeMode="CanResize"
                 WindowState="Maximized"
                 WindowStyle="SingleBorderWindow"
                 WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="FFmpegDownloader"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     Grid.Row="0" />

        <Grid Grid.Row="1"
              Margin="32,0,32,32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Ajout d'un téléchargement -->
            <Grid Grid.Row="0"
                  Grid.Column="0"
                  Margin="0,0,16,16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Ajouter un téléchargement"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,8" />

                <Border Grid.Row="1"
                        Background="#252525"
                        CornerRadius="8"
                        Padding="20">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="URL de la vidéo"
                                       Foreground="White"
                                       FontWeight="SemiBold" />

                            <Grid Margin="0,4,0,0"
                                  VerticalAlignment="Top">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding VideoUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36"
                                         Margin="0,0,10,0" />

                                <Button Grid.Column="1"
                                        Content="À partir d'une cURL"
                                        Click="ParseCurlCommand"
                                        Height="36"
                                        Padding="16,0" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Chemin de sortie"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,0" />

                            <Grid Margin="0,4,0,0"
                                  VerticalAlignment="Top">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Height="36"
                                         Margin="0,0,10,0"
                                         IsReadOnly="True"
                                         Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Grid.Column="1"
                                        Content="Parcourir"
                                        Click="BrowseOutputFile"
                                        Height="36"
                                        Padding="16,0" />
                            </Grid>
                        </StackPanel>

                        <Button Grid.Row="2"
                                Content="Options avancées"
                                Command="{Binding OpenAdvancedOptionsCommand}"
                                HorizontalAlignment="Left"
                                Height="36"
                                Padding="16,0"
                                Margin="0,20,0,0" />

                        <Button Grid.Row="2"
                                Content="Ajouter à la file d'attente"
                                Command="{Binding AddToQueueCommand}"
                                HorizontalAlignment="Right"
                                Height="36"
                                Margin="0,16,0,0" />

                    </Grid>
                </Border>
            </Grid>

            <!-- File d'attente -->
            <Grid Grid.Row="1"
                  Grid.Column="0"
                  Margin="0,0,16,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">

                    <TextBlock Text="File d'attente"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White" />

                    <Button Content="Démarrer"
                            Command="{Binding StartQueueCommand}"
                            Padding="14,8"
                            Margin="8,0,0,0" />

                    <Button Content="Arrêter"
                            Command="{Binding StopQueueCommand}"
                            Padding="14,8"
                            Margin="8,0,0,0" />

                </StackPanel>

                <Border Grid.Row="1"
                        Background="#252525"
                        CornerRadius="8"
                        Padding="20">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl ItemsSource="{Binding Downloads}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border x:Name="Card"
                                            Background="#22252B"
                                            BorderBrush="#353A43"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16"
                                            Margin="0,0,0,12">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Indicateur vertical -->
                                            <Border x:Name="StatusIndicator"
                                                    Grid.Column="0"
                                                    Background="#7D8795"
                                                    CornerRadius="2"
                                                    Margin="0,2,0,2" />

                                            <Grid Grid.Column="1"
                                                  Margin="14,0,0,0">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Nom du fichier -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding FileName}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F5F5F5"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding OutputPath}"
                                                               VerticalAlignment="Center" />

                                                    <!-- Statut -->
                                                    <Border Grid.Column="1"
                                                            x:Name="StatusBadge"
                                                            Background="#343A44"
                                                            CornerRadius="8"
                                                            Padding="10,5">

                                                        <TextBlock Text="{Binding StatusMessage}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#E5E7EB" />
                                                    </Border>
                                                </Grid>

                                                <!-- URL -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Url}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#A1A7B0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Url}" />

                                                <!-- Progression -->
                                                <StackPanel Grid.Row="2">
                                                    <ProgressBar Value="{Binding Progress}"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Height="6"
                                                                 Margin="0,16,0,0" />

                                                    <TextBlock Text="{Binding Progress, StringFormat={}{0:F1}%}"
                                                               Foreground="#A1A7B0"
                                                               FontSize="12"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,6,0,0" />
                                                </StackPanel>

                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Couleurs selon le statut -->
                                    <DataTemplate.Triggers>

                                        <!-- En attente -->
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static enums:DownloadStatus.Pending}">
                                            <Setter TargetName="StatusIndicator"
                                                    Property="Background"
                                                    Value="#7D8795" />
                                            <Setter TargetName="StatusBadge"
                                                    Property="Background"
                                                    Value="#343A44" />
                                        </DataTrigger>

                                        <!-- En cours -->
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static enums:DownloadStatus.Downloading}">
                                            <Setter TargetName="StatusIndicator"
                                                    Property="Background"
                                                    Value="#3B9EFF" />
                                            <Setter TargetName="StatusBadge"
                                                    Property="Background"
                                                    Value="#164B78" />
                                            <Setter TargetName="Card"
                                                    Property="BorderBrush"
                                                    Value="#286BA3" />
                                        </DataTrigger>

                                        <!-- Terminé -->
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static enums:DownloadStatus.Completed}">
                                            <Setter TargetName="StatusIndicator"
                                                    Property="Background"
                                                    Value="#42B883" />
                                            <Setter TargetName="StatusBadge"
                                                    Property="Background"
                                                    Value="#1D5942" />
                                        </DataTrigger>

                                        <!-- Erreur -->
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static enums:DownloadStatus.Failed}">
                                            <Setter TargetName="StatusIndicator"
                                                    Property="Background"
                                                    Value="#E05D5D" />
                                            <Setter TargetName="StatusBadge"
                                                    Property="Background"
                                                    Value="#692F35" />
                                        </DataTrigger>

                                    </DataTemplate.Triggers>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </Border>
            </Grid>

            <!-- Sortie FFmpeg -->
            <Grid Grid.Column="1"
                  Grid.RowSpan="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Sortie FFmpeg"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,8" />

                <Border Grid.Row="1"
                        Background="#151515"
                        CornerRadius="8"
                        Padding="12">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Barre supérieure du terminal -->
                        <DockPanel Margin="0,0,0,12">

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Ellipse Width="10"
                                         Height="10"
                                         Fill="#4CAF50"
                                         Margin="0,0,8,0" />

                                <TextBlock Text="FFmpeg"
                                           Foreground="#A0A0A0"
                                           FontSize="12"
                                           FontWeight="SemiBold" />

                            </StackPanel>

                            <TextBlock Text="En attente"
                                       Foreground="#A0A0A0"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right" />

                        </DockPanel>

                        <!-- Contenu du terminal -->
                        <TextBox Grid.Row="1"
                                 x:Name="FFmpegConsole"
                                 Text="{Binding FFmpegOutput, Mode=OneWay}"
                                 TextChanged="FFmpegOutputChanged"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#D4D4D4"
                                 FontFamily="Cascadia Mono"
                                 FontSize="12"
                                 Padding="0">

                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background"
                                            Value="Transparent" />
                                    <Setter Property="BorderBrush"
                                            Value="Transparent" />
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- Voile de chargement -->
        <Border Grid.RowSpan="2"
                Panel.ZIndex="100"
                Background="#B8000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Animation -->
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="48"
                                 Height="48"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,20" />

                <!-- Message -->
                <TextBlock Text="{Binding LoadingMessage}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

            </StackPanel>
        </Border>

        <ui:ContentDialogHost x:Name="RootContentDialogHost"
                              Grid.RowSpan="2"
                              Panel.ZIndex="1" />
    </Grid>

</ui:FluentWindow>
